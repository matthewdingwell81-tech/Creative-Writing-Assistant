rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      allow get: if owner();
      allow list: if false;
      // users/{uid} currently stores only server-managed entitlement data; the
      // app has no client-editable profile fields in this collection.
      // Firebase Admin SDK writes bypass these client rules.
      allow create, update, delete: if false;
    }
  }
}
